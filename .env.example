# 英语宝审查智能体 — 环境变量配置模板
# 复制此文件为 .env 并填入你的真实密钥：  cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到 Git
#
# ⚠ 安全提醒：本文件是模板，**只能放占位符**。
#   切勿把真实密钥写进来 —— 它会被提交并永久留在 Git 历史里。
#   若曾经误提交过真实密钥，请立即到控制台轮换（撤销旧 key）。

# ─────────────────────────────────────────────
# 阿里云百炼 DashScope（文本主模型）
# ─────────────────────────────────────────────
# 注意：模型在谁家就必须用谁家的 key。百炼的 deepseek-* / qwen* 只能用百炼 key（sk-ws-…）。
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-v4.1-flash
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 每日 LLM 预算阀门（元/天），超限当日拒绝新调用
LLM_DAILY_BUDGET_YUAN=10

# 文本主模型额度耗尽时依次切换（逗号分隔）
LLM_MODEL_FALLBACK=deepseek-v4-flash,deepseek-v3.2

# 【推理型模型必填】不关思维链时，reasoning 会吃光 max_tokens，
#   表现为 content 为空且不报错（所有 AI 结论静默变成空字符串）。
#   列入白名单的模型会自动注入 enable_thinking:false。
#   作用范围按**模型名**判定，对文本与视觉调用同时生效。
LLM_NO_THINK_MODELS=deepseek-v4.1-flash,deepseek-v4-pro-0813,deepseek-v4-pro,qwen3.7-flash

# ─────────────────────────────────────────────
# 视觉模型（截图审查，必须选"真看图"模型）
# ─────────────────────────────────────────────
# ⚠ 勿用纯 OCR 模型：OCR 看不到图标，只能从题面文字反推，会脑补出喇叭/麦克风图标，
#   导致「题目要求听音却没有喇叭图标」这类缺陷漏报。
VISION_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VISION_MODEL=qwen3.8-27b
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 视觉备用链（主模型额度耗尽时依次尝试；仅识别到 quota/403/429/欠费 才切换）
#   fallback1 建议选与主模型**不同系列**的模型 —— 百炼免费额度按模型独立计算，
#   同系列模型会在主模型额度耗尽时一起失效，等于没有备用。
VISION_MODEL_FALLBACK=qwen3.7-flash
VISION_MODEL_FALLBACK2=qwen3.8-max
VISION_MODEL_FALLBACK3=qwen3.8-flash

# ─────────────────────────────────────────────
# ASR 语音识别（可选；未配置时自动降级）
# ─────────────────────────────────────────────
ASR_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ASR_MODEL=qwen-audio-3.0-asr-flash-streaming
ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
# 兼容别名（scripts/common/asr.py 亦识别以下三个名字，二者填其一即可）
# YYB_ASR_API_KEY=
# YYB_ASR_MODEL=
# YYB_ASR_WS_URL=
# YYB_ASR_ENABLED=1

# ─────────────────────────────────────────────
# 通用参数
# ─────────────────────────────────────────────
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.1

# ─────────────────────────────────────────────
# 设备 / 运行
# ─────────────────────────────────────────────
# 指定 adb 设备序列号（多设备在线时必填，否则 uiautomator2 会报 more than one device）
# ANDROID_SERIAL=127.0.0.1:16384
# Flask 服务端口
# PORT=5000

# 惯用的版本 / 年级 / 单元范围（可选，供脚本默认取值）
# YYB_VERSION=教科版(2024审定)
# YYB_GRADE=五年级上册
# YYB_UNIT_FROM=1
# YYB_UNIT_TO=7

# ─────────────────────────────────────────────
# 邮件推送（可选，错题报告发送）
# ─────────────────────────────────────────────
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=465
# EMAIL_USER=
# EMAIL_PASSWORD=
